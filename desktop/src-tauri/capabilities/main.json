{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local Tether main window with least-privilege commands",
  "windows": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-get-vault-status",
    "allow-list-drafts",
    "allow-get-draft",
    "allow-get-revisions",
    "allow-delete-draft",
    "allow-prune-vault",
    "allow-set-retention-days",
    "allow-get-autostart-status",
    "allow-set-autostart",
    "allow-list-companions",
    "allow-save-custom-companion",
    "allow-delete-custom-companion",
    "allow-install-catalog-companion",
    "allow-uninstall-autostart",
    "allow-purge-vault-data",
    "allow-uninstall-app",
    "allow-get-companion-clip",
    "allow-get-system-status"
  ]
}
