{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tether",
  "version": "0.1.34",
  "identifier": "app.tether.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main", "companion-overlay"]
    },
    "windows": [
      {
        "label": "main",
        "title": "Tether",
        "width": 900,
        "height": 640,
        "minWidth": 600,
        "minHeight": 480,
        "resizable": true
      },
      {
        "label": "companion-overlay",
        "url": "companion-overlay.html",
        "title": "Tether Companion",
        "width": 360,
        "height": 310,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../assets/companions/grace": "assets/companions/grace",
      "../../assets/companions/rory": "assets/companions/rory",
      "../../assets/companions/axel": "assets/companions/axel",
      "../../assets/companions/bao": "assets/companions/bao",
      "../../assets/companions/blaze": "assets/companions/blaze",
      "../../assets/companions/bolt": "assets/companions/bolt",
      "../../assets/companions/captain-dew": "assets/companions/captain-dew",
      "../../assets/companions/chip": "assets/companions/chip",
      "../../assets/companions/coco": "assets/companions/coco",
      "../../assets/companions/daisy": "assets/companions/daisy",
      "../../assets/companions/doc": "assets/companions/doc",
      "../../assets/companions/ember": "assets/companions/ember",
      "../../assets/companions/finn": "assets/companions/finn",
      "../../assets/companions/iris": "assets/companions/iris",
      "../../assets/companions/luna": "assets/companions/luna",
      "../../assets/companions/marmalade": "assets/companions/marmalade",
      "../../assets/companions/nimbus": "assets/companions/nimbus",
      "../../assets/companions/nova": "assets/companions/nova",
      "../../assets/companions/ollie": "assets/companions/ollie",
      "../../assets/companions/peanut": "assets/companions/peanut",
      "../../assets/companions/penny": "assets/companions/penny",
      "../../assets/companions/pixel": "assets/companions/pixel",
      "../../assets/companions/quest": "assets/companions/quest",
      "../../assets/companions/sage": "assets/companions/sage",
      "../../assets/companions/shadow": "assets/companions/shadow",
      "../../assets/companions/spike": "assets/companions/spike",
      "../../assets/companions/splash": "assets/companions/splash",
      "../../assets/companions/theo": "assets/companions/theo",
      "../../assets/companions/twirl": "assets/companions/twirl",
      "../../assets/companions/waddle": "assets/companions/waddle",
      "../../assets/companions/zen": "assets/companions/zen",
      "../../assets/companions/zippy": "assets/companions/zippy"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "minimumWebview2Version": "109.0.1518.78",
        "languages": ["English"],
        "startMenuFolder": "Tether",
        "compression": "lzma"
      }
    }
  }
}
