# Normalise line endings across platforms
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# GitHub Linguist language overrides
# Standalone offline studio web tools and assets treated as vendored / non-detectable
gui/** linguist-vendored
assets/** linguist-vendored
shots/** linguist-vendored
*.html linguist-detectable=false
